          "refId": "A",
          "expr": "worker:atlas_tick_duration_seconds:p99{worker=~\"$worker\"}",
          "legendFormat": "{{worker}} tick p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "0.5 * worker:atlas_tick_interval_seconds{worker=~\"$worker\"}",
          "legendFormat": "{{worker}} 50% of interval"
