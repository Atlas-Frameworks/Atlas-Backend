{
  "name": "@atlas/map-cesium",
  "version": "0.0.1",
  "private": true,
  "description": "Cesium implementation of the client SDK MapAdapter (C-05). See docs/tasks/boaz/06-client-sdk.md.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src bench",
    "test": "vitest run",
    "bench": "node bench/build.mjs && node bench/serve.mjs"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@atlas/client-sdk": "*",
    "cesium": "1.146.0"
  }
}
