{
  "name": "@atlas/client-sdk",
  "version": "0.0.1",
  "private": true,
  "description": "Framework-free browser SDK that runs in a dedicated Web Worker: transport, protocol, sequence checks, typed-array map store, pages, detail, map adapter interface. See docs/tasks/boaz/06-client-sdk.md.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@atlas/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./worker": {
      "@atlas/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src",
    "test": "vitest run --passWithNoTests",
    "bench": "vitest run --config vitest.perf.config.ts",
    "example": "node examples/build.mjs && node examples/serve.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@atlas/protocol": "*"
  }
}
