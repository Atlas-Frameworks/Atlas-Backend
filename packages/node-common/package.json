{
  "name": "@atlas/node-common",
  "version": "0.0.1",
  "private": true,
  "description": "Shared config loading, structured logging and error types for every Node app. See docs/tasks/01-foundation.md (F-03).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src",
    "test": "vitest run"
  },
  "dependencies": {
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
