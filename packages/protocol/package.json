{
  "name": "@atlas/protocol",
  "version": "0.0.1",
  "private": true,
  "description": "Protobuf schema and generated TypeScript types shared by client, view service and replicator. See docs/tasks/03-protocol.md.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --deny-warnings src",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  },
  "files": [
    "dist"
  ]
}
