{
  "name": "@atlas/protocol",
  "version": "0.0.1",
  "private": true,
  "description": "Protobuf schema and generated TypeScript types shared by client, view service and replicator. See docs/tasks/dvir/03-protocol.md.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@atlas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cluster": {
      "@atlas/source": "./src/cluster.ts",
      "types": "./dist/cluster.d.ts",
      "default": "./dist/cluster.js"
    }
  },
  "scripts": {
    "generate": "buf generate",
    "prebuild": "npm run generate",
    "build": "tsc -b tsconfig.build.json",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prelint": "npm run generate",
    "lint": "buf lint && oxlint --type-aware --deny-warnings src",
    "breaking": "buf breaking --against \"../../.git#branch=main,subdir=packages/protocol\"",
    "pretest": "npm run generate",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.74.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
