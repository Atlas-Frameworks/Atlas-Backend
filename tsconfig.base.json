{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // Resolve @atlas/* workspace packages to their TypeScript sources (the "@atlas/source" export
    // condition), so editors, typecheck and tests work without building first. Build configs
    // (tsconfig.build.json) clear this and resolve to the packages' compiled dist/ instead.
    "customConditions": ["@atlas/source"]
  }
}
