{
  "name": "atlas-realtime",
  "private": true,
  "description": "Proof of concept for the Atlas realtime view service (see docs/architecture-plan.md)",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.21.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=100",
    "postgres:setup": "node infra/postgres/scripts/setup-synchronization.mjs",
    "postgres:seed": "node infra/postgres/scripts/seed-commerce.mjs",
    "publisher:start": "npm run dev --workspace @atlas/change-publisher",
    "benchmark:setup": "node infra/benchmark/setup.mjs",
    "benchmark:run": "node infra/benchmark/run.mjs",
    "benchmark:report": "node infra/benchmark/report.mjs",
    "benchmark:debezium:build": "docker compose -f infra/docker-compose.yml -f infra/benchmark/docker-compose.yml build debezium-benchmark",
    "benchmark:debezium:start": "docker compose -f infra/docker-compose.yml -f infra/benchmark/docker-compose.yml up -d debezium-benchmark",
    "benchmark:debezium:stop": "docker compose -f infra/docker-compose.yml -f infra/benchmark/docker-compose.yml stop debezium-benchmark",
    "replicator:simulate": "node apps/replicator-sim/scripts/data-update-simulator.mjs",
    "replicator:simulate:publisher": "node apps/replicator-sim/scripts/data-update-simulator.mjs --schema benchmark_publisher",
    "replicator:simulate:debezium": "node apps/replicator-sim/scripts/data-update-simulator.mjs --schema benchmark_debezium",
    "replicator:watch": "node apps/replicator-sim/scripts/sync-event-listener.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
