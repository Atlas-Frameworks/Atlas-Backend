{
  "name": "@atlas/change-publisher",
  "version": "0.0.1",
  "description": "Claims sequenced entity events from Postgres and publishes them to Redis Streams",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ioredis": "^5.8.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "oxlint": "^1.58.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
