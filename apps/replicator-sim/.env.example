# replicator-sim environment (validated at startup by src/config.ts; keep both in sync).
# Copied to .env on the first `npm run dev:replicator`. Variables set in the shell win over this file.

# development = pretty logs; production = one JSON object per line.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# HTTP port (health and control endpoints).
PORT=3100
