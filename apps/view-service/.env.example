# view-service environment (validated at startup by src/config.ts; keep both in sync).
# Copied to .env on the first `npm run dev:view-service`. Variables set in the shell win over this file.

# development = pretty logs; production = one JSON object per line.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Required. Stable worker name; in OpenShift it is the StatefulSet pod name.
WORKER_NAME=view-service-0
# HTTP + WebSocket port for clients.
PORT=3000
# Worker-to-worker gRPC port.
GRPC_PORT=50051
